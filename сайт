<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Вход и Регистрация</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f0f4f8;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            height: 100vh;
        }

        h1 {
            width: 100%;
            background-color: #333;
            color: white;
            text-align: center;
            line-height: 2cm;
            margin: 0;
            font-size: 1.8rem;
        }

        .top-right {
            display: flex;
            gap: 15px;
            justify-content: flex-end;
            margin-top: 20px;
            width: 100%;
            padding-right: 20px;
        }

        .top-left {
            display: flex;
            gap: 15px;
            justify-content: flex-start;
            margin-top: 20px;
            width: 100%;
            padding-left: 20px;
            flex-direction: column;
            align-items: flex-start;
        }

        .top-left button,
        .top-right button {
            padding: 12px 24px;
            background-color: #0056b3;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

        .top-left button:hover,
        .top-right button:hover {
            background-color: #004494;
        }

        .top-right button {
            width: 5cm;
        }

        .menu-container {
            margin-top: 20px;
            width: 100%;
        }

        .dropdown {
            position: relative;
            display: inline-block;
        }

        .dropbtn {
            padding: 12px 24px;
            background-color: #009688;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 1rem;
        }

        .dropdown-content {
            display: none;
            position: absolute;
            background-color: #ffffff;
            min-width: 200px;
            box-shadow: 0px 8px 16px rgba(0, 0, 0, 0.2);
            z-index: 1;
        }

        .dropdown:hover .dropdown-content {
            display: block;
        }

        .dropdown-content a {
            padding: 12px 16px;
            text-decoration: none;
            display: block;
            color: #333;
            font-size: 1rem;
        }

        .dropdown-content a:hover {
            background-color: #ddd;
        }

        .container {
            width: 100%;
            max-width: 450px;
            margin: 30px auto;
            padding: 25px;
            background-color: white;
            border-radius: 8px;
            box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
            text-align: center;
            position: relative;
            z-index: 2;
        }

        input {
            width: 100%;
            padding: 12px;
            margin: 10px 0;
            border-radius: 5px;
            border: 1px solid #ddd;
            font-size: 1rem;
        }

        button {
            width: 100%;
            padding: 12px;
            background-color: #4CAF50;
            color: white;
            border: none;
            border-radius: 5px;
            font-size: 1rem;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

        button:hover {
            background-color: #45a049;
        }

        .hidden {
            display: none;
        }

        #file-input {
            width: 4cm;
            margin-bottom: 10px;
        }

        .password-manager {
            margin-top: 20px;
        }

        .password-entry {
            margin: 10px 0;
        }

        .content-section {
            display: none;
            padding: 20px;
            background-color: #ffffff;
            margin-top: 20px;
            border-radius: 8px;
            box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
            width: 80%;
            max-width: 600px;
            margin-top: 40px;
        }

        .alert {
            color: red;
            font-weight: bold;
        }

        .auth-code-container {
            width: 100%;
            background-color: #ffd700;
            color: black;
            padding: 10px;
            text-align: center;
            font-size: 1.1rem;
            display: none;
        }
    </style>
</head>
<body>

    <h1>Password Management Systems</h1>

    <div class="top-right">
        <button onclick="showLogin()">Вход</button>
        <button onclick="showRegistration()">Регистрация</button>
    </div>

    <div class="top-left">
        <div class="dropdown">
            <button class="dropbtn">Меню</button>
            <div class="dropdown-content">
                <a href="#" onclick="showSection('password-management')">1. Система за управление на пароли</a>
                <a href="#" onclick="showSection('twofa')">2. Двустепенна Автентикация</a>
                <a href="#" onclick="showSection('password-manager')">3. Мениджър на пароли</a>
                <a href="#" onclick="showFileSelection()">Изтегли</a>
            </div>
        </div>
    </div>

    <!-- Auth code notification -->
    <div id="auth-code-container" class="auth-code-container">
        Вашият код за двустепенна автентикация е: <span id="auth-code"></span>
    </div>

    <div id="password-management" class="content-section">
        <h2>Система за управление на пароли</h2>
        <p>Това е секцията за управление на пароли. Тук можете да съхранявате и управлявате своите пароли по безопасен начин.</p>
        <button onclick="goBack()">Назад</button>
    </div>

    <div id="twofa" class="content-section">
        <h2>Двустепенна Автентикация</h2>
        <p>Двустепенната автентикация добавя допълнителен слой защита на вашия акаунт. Вие ще трябва да въведете код, изпратен на вашето мобилно устройство или имейл.</p>
        <button onclick="goBack()">Назад</button>
    </div>

    <div id="password-manager" class="content-section">
        <h2>Мениджър на пароли</h2>
        <p>Мениджърът на пароли ви помага да генерирате, съхранявате и управлявате пароли за различни услуги и акаунти.</p>
        <button onclick="goBack()">Назад</button>
    </div>

    <div class="container">
        <div id="login-form" class="hidden">
            <h2>Вход</h2>
            <input type="email" id="login-email" placeholder="Имейл"><br>
            <input type="password" id="login-pass" placeholder="Парола" minlength="10" pattern="[A-Za-z0-9]{10,}" required>
            <button type="button" onclick="togglePassword('login-pass')">👁</button><br>
            <button onclick="login()">Вход</button><br>
            <a href="#" onclick="forgotPassword()">Забравена парола</a><br>
            <button onclick="closeLogin()">Затвори</button>
        </div>

        <div id="forgot-password" class="hidden">
            <h2>Възстановяване на парола</h2>
            <input type="email" id="reset-email" placeholder="Въведете имейл за възстановяване" required><br>
            <button onclick="resetPassword()">Възстанови парола</button><br>
            <button onclick="closeForgotPassword()">Затвори</button>
        </div>

        <div id="register-form" class="hidden">
            <h2>Регистрация</h2>
            <input type="text" id="register-username" placeholder="Потребителско име" required><br>
            <input type="email" id="register-email" placeholder="Имейл" required><br>
            <input type="password" id="register-pass" placeholder="Парола" minlength="10" pattern="[A-Za-z0-9]{10,}" required>
            <button type="button" onclick="togglePassword('register-pass')">👁</button><br>
            <button onclick="register()">Регистрация</button><br>
            <button onclick="closeRegister()">Затвори</button>
        </div>

        <div id="twofa-form" class="hidden">
            <h2>Двустепенна автентикация</h2>
            <input type="text" id="twofa-code" placeholder="Въведете кода" required><br>
            <button onclick="verify2FA()">Потвърди</button>
        </div>

        <div id="dashboard" class="hidden">
            <h2>Табло за управление</h2>
            <p>Добре дошли в таблото за управление!</p>
            <button onclick="logout()">Изход</button>
        </div>
    </div>

    <script>
        let userData = {};
        let isAuthenticated = false;
        let isTwoFA = false;

        function showLogin() {
            document.getElementById("login-form").classList.remove("hidden");
            document.getElementById("register-form").classList.add("hidden");
        }

        function closeLogin() {
            document.getElementById("login-form").classList.add("hidden");
        }

        function showRegistration() {
            document.getElementById("register-form").classList.remove("hidden");
            document.getElementById("login-form").classList.add("hidden");
        }

        function closeRegister() {
            document.getElementById("register-form").classList.add("hidden");
        }

        function togglePassword(id) {
            const passField = document.getElementById(id);
            passField.type = passField.type === "password" ? "text" : "password";
        }

        function register() {
            const username = document.getElementById("register-username").value;
            const email = document.getElementById("register-email").value;
            const pass = document.getElementById("register-pass").value;

            if (username && email && pass) {
                userData = {
                    username,
                    email,
                    password: pass
                };
                isAuthenticated = true;
                alert("Регистрация успешна!");
                showTwoFAScreen();
                generateAuthCode(); // Генерираме код за двустепенната автентикация
            } else {
                alert("Попълнете всички полета.");
            }
        }

        function login() {
            const email = document.getElementById("login-email").value;
            const pass = document.getElementById("login-pass").value;

            if (email && pass && userData.email === email && userData.password === pass) {
                isAuthenticated = true;
                alert("Вход успешен!");
                showTwoFAScreen();
                generateAuthCode(); // Генерираме код за двустепенната автентикация
            } else {
                alert("Невалидни данни за вход.");
            }
        }

        function showTwoFAScreen() {
            document.getElementById("twofa-form").classList.remove("hidden");
            document.getElementById("login-form").classList.add("hidden");
            document.getElementById("register-form").classList.add("hidden");
        }

        function generateAuthCode() {
            const code = Math.floor(100000 + Math.random() * 900000); // Генерираме случайно 6-цифрово число
            document.getElementById("auth-code").textContent = code; // Показваме кода
            document.getElementById("auth-code-container").classList.remove("hidden");
        }

        function verify2FA() {
            const code = document.getElementById("twofa-code").value;
            const correctCode = document.getElementById("auth-code").textContent;
            
            if (code === correctCode) {
                isTwoFA = true;
                alert("Двустепенната автентикация е успешна!");
                showDashboard();
            } else {
                alert("Невалиден код.");
            }
        }

        function showDashboard() {
            document.getElementById("twofa-form").classList.add("hidden");
            document.getElementById("dashboard").classList.remove("hidden");
        }

        function logout() {
            isAuthenticated = false;
            isTwoFA = false;
            document.getElementById("dashboard").classList.add("hidden");
            document.getElementById("login-form").classList.remove("hidden");
            document.getElementById("auth-code-container").classList.add("hidden"); // Скриваме кода при изход
            alert("Изход успешно!");
        }

        function showSection(section) {
            const sections = ["password-management", "twofa", "password-manager"];
            sections.forEach(sec => {
                document.getElementById(sec).classList.add("hidden");
            });
            document.getElementById(section).classList.remove("hidden");
        }

        function goBack() {
            document.getElementById("password-management").classList.add("hidden");
            document.getElementById("twofa").classList.add("hidden");
            document.getElementById("password-manager").classList.add("hidden");
        }

        function savePassword() {
            const service = document.getElementById("service-name").value;
            const email = document.getElementById("service-email").value;
            const password = document.getElementById("service-password").value;

            if (service && email && password) {
                const passwordEntry = document.createElement("li");
                passwordEntry.textContent = `${service} - ${email}`;
                document.getElementById("password-list").appendChild(passwordEntry);
            } else {
                alert("Попълнете всички полета.");
            }
        }

        function showFileSelection() {
            document.getElementById("file-selection").classList.remove("hidden");
        }

        function closeFileSelection() {
            document.getElementById("file-selection").classList.add("hidden");
        }

        function downloadFile() {
            alert("Изтегляне на файл е успешно!");
        }
    </script>
</body>
</html>
